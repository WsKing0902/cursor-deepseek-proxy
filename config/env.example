# ============================================================
#  Cursor × DeepSeek V4 配置文件
# ============================================================
# 获取 API Key: https://platform.deepseek.com → API Keys
# 需要充值才能使用（最低充值金额 ¥1 起）

# DeepSeek API Key（必填！）
DEEPSEEK_API_KEY=sk-your-key-here

# 上游 API 地址（一般不用改）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 默认模型（部署时会写入 Cursor；下拉中 Pro 与 Flash 均可选）
#   deepseek-v4-pro   — 更强推理，适合复杂 Agent 任务
#   deepseek-v4-flash — 更快、更省 token，适合日常编码
DEEPSEEK_MODEL=deepseek-v4-pro

# 代理公网地址（setup.sh 会自动填写，不要手动改）
CURSOR_BASE_URL=
